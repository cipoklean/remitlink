# Foundry
# Use root-anchored paths: a bare `lib/` would also match src/lib and silently
# exclude the app's chain/corridor config from the repo.
/lib/
/contracts/out/
/contracts/cache/

# Foundry broadcast artifacts
broadcast/

# Vercel
.vercel

# AGENT.md - internal agent working memory, not part of the submission repo.
# NOTE: it is already in git history (committed before this rule), so previous
# commits still carry it. The local copy at ~/remitlink/AGENT.md is unaffected.
AGENT.md

# audit.md - internal working doc from the 2026-10-05 full audit. Never committed.
audit.md

# docs/ - internal working notes and recording directions (demo-video script,
# shot lists). Author-facing, not part of the submission repo; stage directions
# like "never say wallet on camera" read oddly to judges reviewing the repo.
docs/

# Envio HyperIndex (indexer runtime state, regenerable)
envio/generated/
envio/node_modules/
envio/.env
envio/pnpm-lock.yaml
