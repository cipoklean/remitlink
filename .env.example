NEXT_PUBLIC_PRIVY_APP_ID=
# Gas sponsorship (Privy fee sponsorship, EIP-7702). Requires "Sponsor gas fees"
# enabled for Monad Testnet in the Privy dashboard. Set to false to send
# ordinary user-paid transactions instead.
NEXT_PUBLIC_SPONSOR_GAS=true
# Server-side only (never ships to the browser):
# PRIVY_APP_SECRET=
# Test-money faucet (AGENT.md 7b A1). Testnet only. Server-side, never NEXT_PUBLIC_.
TREASURY_PRIVATE_KEY=
TREASURY_DAILY_CAP_USDC=300
TREASURY_DRIP_COOLDOWN_MS=3600000
